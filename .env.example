# Wakatime OAuth access token (required)
WAKA_ACCESS_TOKEN=

# MongoDB
MONGODB_URI=
MONGO_DB=

# Redis holding project rename rules (optional)
REDIS_URL=
# Prefix prepended to all Redis keys, e.g. "waka:" -> "waka:project_replace"
REDIS_PREFIX=waka:

# Upstash Redis REST API, used for log shipping (required)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Set to "true" to run a fetch immediately on startup
RUN_NOW=
